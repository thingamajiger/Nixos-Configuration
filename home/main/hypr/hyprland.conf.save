monitor=,preferred,auto,1
 monitor=DP-1,2560x1440@165,0x0,1
 monitor=HDMI-A-1,1680x1050@60,-1680x0,1

animations {
    enabled = yes

    bezier = smooth, 0.2, 0.9, 0.2, 1.0

    animation = workspaces, 1, 3, smooth, slidefadevert
animation = windowsIn, 1, 5, smooth, popin
    animation = windowsOut, 1, 5, smooth, popin
}

exec-once = bash -c "sleep 3 && waybar"
exec-once = dunst
exec-once = thunar --daemon
exec-once = /usr/lib/polkit-kde-authentication-agent-1
# exec-once = hyprpaper
exec-once = mkdir -p ~/.cache/awww
exec-once = awww-daemon
exec-once = sleep 3 && awww img /home/tmajig/Pictures/Wallpapers/abandoned.jpg
exec-once = nm-applet --indicator
env = XCURSOR_THEME,Banana
env = XCURSOR_SIZE,32
env = QT_QPA_PLATFORMTHEME,qt6ct
env = QT_QPA_PLATFORMTHEME,qt5ct

input {
    kb_layout = us
    follow_mouse = 1
    touchpad {
        natural_scroll = no
    }
    sensitivity = 0
}
general {
    gaps_in = 5
    gaps_out = 10

    border_size = 2

    col.active_border = rgba(999999ff)
    col.inactive_border = rgba(666666dd)

    resize_on_border = true

    allow_tearing = false

    layout = dwindle
}

decoration {
    rounding = 10

    blur {
        enabled = true
        size = 3 
        passes = 2
        noise = 0.02
    }
}

misc {
    vrr = 1
}

bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow
bind = , XF86AudioNext, exec, playerctl next
bind = , XF86AudioPrev, exec, playerctl previous
bind = SUPER, RETURN, exec, kitty
bind = SUPER, S, exec, spotify-launcher
bind = SUPER, D, exec, ~/.config/rofi/launchers/type-3/launcher.sh
bind = SUPER, B, exec, zen-browser
bind = SUPER, X, exec, pavucontrol
bind = SUPER, R, exec, hyprctl reload
bind = SUPER, Q, killactive
bind = SUPER, M, exit
bind = SUPER, E, exec, thunar
bind = SUPER, F, fullscreen
bind = SUPER, V, togglefloating
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bind = SUPER, 6, workspace, 6
bind = SUPER, 7, workspace, 7
bind = SUPER, left, movefocus, l
bind = SUPER, right, movefocus, r
bind = SUPER, up, movefocus, u
bind = SUPER, down, movefocus, d
bind = SUPER SHIFT, 1, movetoworkspace, 1
bind = SUPER SHIFT, 2, movetoworkspace, 2
bind = SUPER SHIFT, 3, movetoworkspace, 3
bind = SUPER SHIFT, 4, movetoworkspace, 4
bind = , F6, exec, ~/.config/hypr/autoclick.sh
bind = SHIFT, F6, exec, ~/bob-loop.sh

force_xwayland = false

windowrule = match:class org.kde.dolphin, opacity 0.75 0.75
blurls = rofi

# layerrule = blur, dunst

# windowrule = opacity 0.85 0.85, match:class ^(Dunst)$

# QuickShell layer rules for current Hyprland syntax

layerrule = animation popin, match:namespace ^(quickshell.*)$
layerrule = blur on, match:namespace ^(quickshell.*)$
layerrule = ignore_alpha 0.3, match:namespace ^(quickshell.*)$

# Optional: if QuickShell popups look weird, uncomment this instead of the animation line above
# layerrule = no_anim on, match:namespace ^(quickshell.*)$

windowrule {
    name = xwayland-video-bridge-fixes
    match:class = xwaylandvideobridge

    no_initial_focus = true
    no_focus = true
    no_anim = true
    no_blur = true
    max_size = 1 1
    opacity = 0.0
}
