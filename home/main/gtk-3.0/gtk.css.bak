@define-color accent_color #ff0000;
@define-color accent_fg_color #ffffff;
@define-color accent_bg_color #880000;

@define-color window_bg_color rgba(0,0,0,0.88);
@define-color window_fg_color #ff4444;

@define-color headerbar_bg_color rgba(10,10,10,0.92);
@define-color headerbar_fg_color #ff4444;

@define-color popover_bg_color rgba(15,15,15,0.95);
@define-color popover_fg_color #ff4444;

@define-color view_bg_color rgba(5,5,5,0.90);
@define-color view_fg_color #ff4444;

@define-color card_bg_color rgba(20,20,20,0.85);
@define-color card_fg_color #ff4444;

@define-color sidebar_bg_color rgba(8,8,8,0.92);
@define-color sidebar_fg_color #cc3333;

@define-color sidebar_border_color rgba(100,0,0,0.4);
@define-color sidebar_backdrop_color rgba(0,0,0,0.8);

@define-color theme_selected_bg_color rgba(120,0,0,0.35);
@define-color theme_selected_fg_color #ff6666;

@import "thunar.css";
@import 'colors.css';

.thunar,
window.thunar,
window {
    background-color: rgba(0,0,0,0.92);
    color: #ff4444;
}

.thunar .view,
.thunar treeview,
.thunar treeview.view,
.thunar iconview,
.thunar .standard-view {
    background-color: rgba(0,0,0,0.92);
    color: #ff4444;
}

.thunar sidebar,
.thunar .sidebar,
.thunar placessidebar,
.thunar placessidebar row {
    background-color: rgba(5,5,5,0.95);
    color: #ff4444;
}

.thunar headerbar,
.thunar toolbar,
.thunar menubar {
    background-color: rgba(8,8,8,0.96);
    color: #ff4444;
}

.thunar entry {
    background-color: rgba(20,0,0,0.85);
    color: #ff4444;
    border: 1px solid #880000;
    border-radius: 8px;
}

.thunar *:selected {
    background-color: rgba(120,0,0,0.55);
    color: #ff7777;
}

.view,
treeview,
treeview.view,
iconview,
.standard-view,
.nautilus-window .view,
.thunar .view {
    background-color: rgba(0,0,0,0.96);
    color: #ff4444;
}
rubberband,
selection {
    background-color: rgba(120,0,0,0.45);
}

.thunar .standard-view,
.thunar scrolledwindow,
.thunar scrolledwindow viewport,
.thunar iconview,
.thunar treeview,
.thunar .view,
.standard-view,
iconview,
treeview,
viewport {
    background-color: rgba(0,0,0,0.97);
    background-image: none;
    box-shadow: none;
    color: #ff4444;
}

* {
    background-image: none;
}

.thunar * {
    background-color: rgba(0,0,0,0.97);
    color: #ff4444;
}

.thunar .standard-view .view,
.thunar .standard-view.view,
.thunar .view:not(:selected),
.thunar iconview.view,
.thunar treeview.view,
.thunar widget.view {
    background-color: #000000;
    background: #000000;
    color: #ff4444;
}

/* Thunar file area brute-force */
.thunar * {
    background-image: none;
}

.thunar .standard-view,
.thunar .standard-view *,
.thunar scrolledwindow,
.thunar scrolledwindow *,
.thunar viewport,
.thunar viewport *,
.thunar iconview,
.thunar iconview *,
.thunar treeview,
.thunar treeview *,
.thunar widget,
.thunar widget * {
    background-color: #000000;
    background: #000000;
    color: #ff4444;
}

.thunar *:selected {
    background-color: #550000;
    color: #ff7777;
}
